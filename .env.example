# Copy to .env.local for local commands. .env.local is gitignored.

# Deployed Nomic contract address.
NOMIC_ADDRESS=0x...

# Optional RPC override if your GenLayer CLI needs it.
NOMIC_RPC=

# Optional named account already imported into the GenLayer CLI keystore.
NOMIC_ACCOUNT=alice

# Do not put a raw private key here for the current CLI flow.
# Import it into the GenLayer CLI keystore instead:
#   genlayer account import
#   genlayer account use alice
